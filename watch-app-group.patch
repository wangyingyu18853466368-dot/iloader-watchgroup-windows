+/// Reject a stale or insufficient profile before signing or transferring either app.
+fn validate_watch_app_group(
+    bundle_id: &str,
+    entitlements: &Dictionary,
+    expected_group: &str,
+) -> Result<(), Report> {
+    let authorized = entitlements
+        .get("com.apple.security.application-groups")
+        .and_then(plist::Value::as_array)
+        .is_some_and(|groups| {
+            groups
+                .iter()
+                .any(|group| group.as_string() == Some(expected_group))
+        });
+    if !authorized {
+        bail!(
+            "Apple's provisioning profile for Watch app {bundle_id} does not authorize the requested App Group. Installation stopped before transfer; changing local entitlements alone cannot grant this permission."
+        );
+    }
+    Ok(())
+}
