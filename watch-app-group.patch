+#[cfg(test)]
+mod watch_app_group_tests {
+    use super::*;
+    use plist::Value;
+
+    #[test]
+    fn missing_or_wrong_watch_group_stops_installation() {
+        let mut entitlements = Dictionary::new();
+        assert!(
+            validate_watch_app_group("app.watchkitapp", &entitlements, "group.expected").is_err()
+        );
+        entitlements.insert(
+            "com.apple.security.application-groups".into(),
+            Value::Array(vec![Value::String("group.other-team".into())]),
+        );
+        assert!(
+            validate_watch_app_group("app.watchkitapp", &entitlements, "group.expected").is_err()
+        );
+        entitlements.insert(
+            "com.apple.security.application-groups".into(),
+            Value::String("group.expected".into()),
+        );
+        assert!(
+            validate_watch_app_group("app.watchkitapp", &entitlements, "group.expected").is_err()
+        );
+    }
+
+    #[test]
+    fn exact_watch_group_is_accepted_among_multiple_authorized_groups() {
+        let mut entitlements = Dictionary::new();
+        entitlements.insert(
+            "com.apple.security.application-groups".into(),
+            Value::Array(vec![
+                Value::String("group.unrelated".into()),
+                Value::String("group.expected".into()),
+            ]),
+        );
+        assert!(
+            validate_watch_app_group("app.watchkitapp", &entitlements, "group.expected").is_ok()
+        );
+    }
