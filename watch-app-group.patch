+    // Synthetic loopback data only: no Apple account, keyring or remote service.
+    async fn fixture(
+        body: &str,
+        status: u16,
+    ) -> (RemoteV3AnisetteProvider, tokio::task::JoinHandle<()>) {
+        use tokio::{
+            io::{AsyncReadExt, AsyncWriteExt},
+            net::TcpListener,
+        };
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let address = listener.local_addr().unwrap();
+        let response = format!(
+            "HTTP/1.1 {status} Test\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+            body.len()
+        );
+        let server = tokio::spawn(async move {
+            let (mut socket, _) = listener.accept().await.unwrap();
+            let mut bytes = vec![0; 4096];
+            let count = socket.read(&mut bytes).await.unwrap();
+            assert!(
+                String::from_utf8_lossy(&bytes[..count])
+                    .starts_with("GET /prefix/v3/client_info HTTP/1.1\r\n")
+            );
+            socket.write_all(response.as_bytes()).await.unwrap();
+            socket.shutdown().await.unwrap();
+        });
+        let mut provider = RemoteV3AnisetteProvider::new(
+            &format!("http://{address}/prefix/"),
+            Box::new(crate::util::storage::InMemoryStorage::new()),
+            "0".into(),
+        )
+        .unwrap();
+        provider.client =
+            MwClientBuilder::new(ClientBuilder::new().no_proxy().build().unwrap()).build();
+        (provider, server)
+    }
