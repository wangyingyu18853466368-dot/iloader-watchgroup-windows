+        )
+        .await;
+        assert_eq!(
+            provider.get_client_info().await.unwrap().client_info,
+            "fixture identity A"
+        );
+        server.await.unwrap();
+        // Listener is now closed; this succeeds only when the cached identity is reused.
+        assert_eq!(
+            provider.get_client_info().await.unwrap().user_agent,
+            "fixture agent A"
+        );
+        let (second, second_server) = fixture(
+            r#"{"client_info":"fixture identity B","user_agent":"fixture agent B"}"#,
+            200,
+        )
+        .await;
+        let provider = provider.set_url(&second.url);
